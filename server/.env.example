# === Google OAuth (required for Google Calendar sync) ===
# Get these from https://console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-app.railway.app/auth/google/callback

# === Auth ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret

# === App ===
PORT=3001
NODE_ENV=production
# Used for Google OAuth redirect — set to your Railway app URL
CLIENT_URL=https://your-app.railway.app
# Path for SQLite database (default: <repo-root>/data/lifeos.db)
# LIFEOS_DB_PATH=/data/lifeos.db

# === Push Notifications ===
# Required for web push (VAPID). Set contact email for push service.
# VAPID_CONTACT=your@email.com

# === Webhooks ===
# Secret for /api/webhooks endpoint
# WEBHOOK_SECRET=your-webhook-secret

# === Logging ===
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

{
  "name": "life-os",
  "version": "1.0.0",
  "private": true,
  "description": "Life OS — built for Othmane Elcaidi. Built in public. Rooted in faith. No shortcuts.",
  "scripts": {
    "seed": "cd server && node run-seed.js",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && node --watch index.js",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^8.2.2"
  }
}
